{
  "name": "todocal-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:api": "openapi-typescript ../../api/openapi.yaml -o src/shared/api/apiTypes.generated.ts && oxfmt --write src/shared/api/apiTypes.generated.ts",
    "test:e2e": "playwright test",
    "format": "oxfmt --write src tests scripts *.ts package.json tsconfig.json .oxfmtrc.json .oxlintrc.json",
    "format:check": "oxfmt --check src tests scripts *.ts package.json tsconfig.json .oxfmtrc.json .oxlintrc.json",
    "lint": "oxlint --deny-warnings src tests scripts *.ts && npm run check:ui",
    "lint:fix": "oxlint --fix --deny-warnings src tests scripts *.ts && npm run check:ui",
    "check:architecture": "node scripts/checkArchitecture.mjs && node --test scripts/checkArchitecture.test.mjs",
    "test:quality-tools": "node scripts/checkQualityTools.mjs",
    "check:ui": "node scripts/checkUi.mjs && node --test scripts/checkUi.test.mjs"
  },
  "dependencies": {
    "@fullcalendar/core": "6.1.22",
    "@fullcalendar/daygrid": "6.1.22",
    "@fullcalendar/interaction": "6.1.22",
    "@fullcalendar/react": "6.1.22",
    "@fullcalendar/timegrid": "6.1.22",
    "@sentry/browser": "11.9.0",
    "@tanstack/react-query": "5.104.5",
    "lucide-react": "1.60.0",
    "luxon": "3.7.2",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@sentry/cli": "3.8.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "type": "module"
}
