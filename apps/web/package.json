{
  "name": "focus-calendar-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:api": "openapi-typescript ../../api/openapi.yaml -o src/lib/api-types.ts && prettier --write src/lib/api-types.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.ts *.json"
  },
  "dependencies": {
    "@fullcalendar/core": "6.1.22",
    "@fullcalendar/daygrid": "6.1.22",
    "@fullcalendar/interaction": "6.1.22",
    "@fullcalendar/react": "6.1.22",
    "@fullcalendar/timegrid": "6.1.22",
    "@tanstack/react-query": "5.104.5",
    "lucide-react": "1.60.0",
    "luxon": "3.7.2",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "type": "module"
}
