{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "todocal",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "keep_vars": true,
  "triggers": {
    "crons": []
  },
  "assets": {
    "directory": "../../apps/web/out",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "vpc_services": [
    {
      "binding": "TODOCAL_API",
      "service_id": "01a1eed9-dd8d-75e2-b7b3-617e4480ac78",
      "remote": true
    }
  ]
}
