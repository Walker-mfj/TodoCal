[Unit]
Description=Deploy exact TodoCal API release for event %i
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
CollectMode=inactive-or-failed

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/todocal
UMask=0077
ExecStart=/usr/bin/python3 /opt/todocal/triggerHost.py %i
TimeoutStartSec=65min
